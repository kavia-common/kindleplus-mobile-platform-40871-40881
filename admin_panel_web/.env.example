# Offline/mock login mode for the Admin Panel (web)
# When true, the login screen accepts any credentials and stores a mock session
# (no backend calls). Use this for local UI development when backend is offline.
# TODO: Set to false to restore real backend authentication.
APP_OFFLINE_LOGIN=true

# Optional: backend base URL (used when APP_OFFLINE_LOGIN=false)
# BACKEND_BASE_URL=http://localhost:3001
