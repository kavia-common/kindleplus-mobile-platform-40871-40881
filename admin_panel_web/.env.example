# Admin Panel Web - Environment Variables
# Copy this file to ".env" in the admin_panel_web project root.
# The app loads this file at startup via flutter_dotenv.
#
# API_BASE_URL: Base URL for the backend API (no trailing slash).
# Local preview backend runs on port 3001 by default.
# Example values:
# - http://localhost:3001
# - https://your-staging-domain.example.com
API_BASE_URL=http://localhost:3001

# Usage:
# 1) Copy: cp .env.example .env
# 2) Edit API_BASE_URL as needed (dev/staging/prod)
# 3) Run: flutter run -d chrome
